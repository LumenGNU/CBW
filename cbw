#!/bin/bash

# Compile Bash Whatever
# Clean Bash Wrapper
# Canonical Bash Writer
# Code Beautifier Wizard
# Compress Bash Work
#    - минификатор/валидатор/форматтер
#
# Принимает bash скрипт и возвращает "релизную" версию:
# - Валидирует синтаксис (не создаст функцию если код невалидный)  
# - Удаляет комментарии и пустые строки (минификация)
# - Канонизирует форматирование
#
# Использует трюк: 
# 1. Загружает содержимое файла как тело bash функции через environment
# 2. Просит bash показать определение функции (= отформатированный код)
# 3. Вырезает служебные строки объявления функции

env "BASH_FUNC_tmp_%%=() {
$(cat "${1}")
}" bash -c 'declare -f tmp_' | tail -n+2 | sed  '1d;$d'
